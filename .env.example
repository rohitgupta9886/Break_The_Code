# Environment Variables Template for Break The Code

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Break The Code"
API_V1_STR="/api/v1"
SECRET_KEY=dev_secret_key_change_in_production_jwt_signature_breakthecode_2026
JWT_SECRET=dev_jwt_secret_change_in_production_breakthecode_2026
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (PostgreSQL with pgvector)
# For local dev without Docker, SQLite fallback is supported: sqlite+aiosqlite:///./breakthecode.db
DATABASE_URL=sqlite+aiosqlite:///./breakthecode.db
SYNC_DATABASE_URL=sqlite:///./breakthecode.db
# When using Docker / Postgres:
# DATABASE_URL=postgresql+asyncpg://btc_user:btc_password@localhost:5432/breakthecode
# SYNC_DATABASE_URL=postgresql://btc_user:btc_password@localhost:5432/breakthecode

# Redis Configuration (Optional for dev fallback)
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (gemini, openai, anthropic, mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
LLM_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=break-the-code
LANGSMITH_TRACING=false

# Client URL (for CORS)
FRONTEND_URL=http://localhost:3000
